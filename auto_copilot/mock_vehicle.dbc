BO_ 2024 UDS_Diagnostic_Response: 8 Gateway
 SG_ UDS_Resp_Payload : 0|64@1+ (1,0) [0|0] "" Diagnostic_Tool

CM_ BO_ 288 "Thermal management and powertrain high frequency sensor telemetry";
CM_ SG_ 288 Coolant_Temp "Inverter and battery loop coolant temperature";
CM_ SG_ 288 Line_Pressure "Coolant loop hydraulic pressure";
CM_ BO_ 384 "High Voltage Battery Management System state";

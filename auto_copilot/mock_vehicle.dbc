 SG_ Thermal_CRC : 48|16@1+ (1,0) [0|65535] "" Gateway

BO_ 384 BMS_Battery_State: 8 ECU_BMS
 SG_ Bus_Voltage : 0|16@1+ (0.1,0) [0|1000] "V" Gateway,Diagnostic_Tool
 SG_ Pack_Current : 16|16@1- (0.1,0) [-3276.8|3276.7] "A" Gateway,Diagnostic_Tool
 SG_ Pack_SOC : 32|8@1+ (0.5,0) [0|100] "%" Gateway,Diagnostic_Tool
 SG_ HV_Interlock : 40|1@1+ (1,0) [0|1] "" Gateway,Diagnostic_Tool
 SG_ BMS_Status : 41|3@1+ (1,0) [0|7] "" Gateway,Diagnostic_Tool
 SG_ BMS_CRC : 48|16@1+ (1,0) [0|65535] "" Gateway

BO_ 528 PDM_Actuator_Command: 8 Gateway
 SG_ Relay_Cut : 0|1@1+ (1,0) [0|1] "" PDM_Actuator
 SG_ Pump_Command : 8|8@1+ (1,0) [0|100] "%" PDM_Actuator
 SG_ Emergency_Shutdown : 16|1@1+ (1,0) [0|1] "" PDM_Actuator

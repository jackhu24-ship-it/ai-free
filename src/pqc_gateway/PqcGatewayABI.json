{
  "contractName": "PqcGatewayContract",
  "version": "v0.2.0-pqc",
  "standards": ["NIST FIPS 203", "NIST FIPS 204", "NIST FIPS 205"],
  "securityLevel": "NIST Level 3 & Level 5",
  "network": "mumbai_testnet",
  "abi": [
    {
      "type": "function",
      "name": "establishSessionKeyMLKEM",
      "inputs": [
        {"name": "clientId", "type": "string"},
        {"name": "clientPublicKey", "type": "bytes"},
        {"name": "ciphertext", "type": "bytes"}
      ],
      "outputs": [
        {"name": "sessionEstablished", "type": "bool"},
        {"name": "latencyMs", "type": "uint256"}
      ],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "verifyAndNotarizeMLDSA",
      "inputs": [
        {"name": "signerId", "type": "string"},
        {"name": "payloadHash", "type": "bytes32"},
        {"name": "publicKey", "type": "bytes"},
        {"name": "signature", "type": "bytes"}
      ],
      "outputs": [
        {"name": "isValid", "type": "bool"},
        {"name": "txHash", "type": "bytes32"}
      ],
      "stateMutability": "nonpayable"
    },
    {
      "type": "function",
      "name": "verifyFallbackSLHDSA",
      "inputs": [
        {"name": "signerId", "type": "string"},
        {"name": "payloadHash", "type": "bytes32"},
        {"name": "publicKey", "type": "bytes"},
        {"name": "signature", "type": "bytes"}
      ],
      "outputs": [
        {"name": "isValid", "type": "bool"}
      ],
      "stateMutability": "view"
    }
  ]
}

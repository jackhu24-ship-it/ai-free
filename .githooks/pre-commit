#!/bin/sh
# pre-commit — 擋下：①大於 2MB 的檔案 ②PDF/PPT/Excel/影像/音樂檔
# 用「git cat-file -s :path」讀暫存區的實際大小（就算檔案已被 .gitignore 擋、或已被 -f 強制加入，也會被抓）
MAX=2097152
FAILED_TMP=$(mktemp)

# 這些副檔名禁止 commit（與 .gitignore 同步；就算 git add -f 強制加入也會被擋）
EXT='\.(pdf|ppt|pptx|pps|ppsx|odp|xls|xlsx|xlsm|xlsb|ods|jpg|jpeg|png|gif|bmp|tiff|webp|mp4|mkv|avi|mov|wmv|flv|m4v|webm|mp3|wav|flac|aac|m4a|ogg|wma)$'

git diff --cached --name-only -z | while IFS= read -r -d '' f; do
  if echo "$f" | grep -qiE "$EXT"; then
    echo "BLOCKED_TYPE: $f" >> "$FAILED_TMP"
    continue
  fi
  size=$(git cat-file -s ":$f" 2>/dev/null)
  if [ -n "$size" ] && [ "$size" -gt "$MAX" ]; then
    echo "BLOCKED_SIZE: $f ($size bytes > 2097152)" >> "$FAILED_TMP"
  fi
done

if [ -s "$FAILED_TMP" ]; then
  echo "=================================================="
  echo " Commit 被擋下（本專案的防呆規則）："
  echo "=================================================="
  cat "$FAILED_TMP"
  echo "--------------------------------------------------"
  echo " 解法：把大檔/檔案類型移到 GitHub 之外的地方"
  echo "       （例如 Google 雲端硬碟、Netlify 靜態存放），"
  echo "       或先 git reset 移除暫存再重新 commit。"
  echo "=================================================="
  rm -f "$FAILED_TMP"
  exit 1
fi
rm -f "$FAILED_TMP"
exit 0
